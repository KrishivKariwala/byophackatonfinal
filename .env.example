# ---- Mode -------------------------------------------------------------
# "demo" runs everything against a local JSON store with simulated payments.
# "supabase" switches the data adapter to Supabase (see supabase/migrations).
DATA_MODE=demo
# Path of the demo store (created and seeded on first run)
DEMO_DB_PATH=./data/demo-db.json
# Secret used to sign the demo session cookie. Change it.
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Supabase (server-only service key; never expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Razorpay TEST MODE only -------------------------------------------
# Leave blank to use the clearly labelled demo payment adapter.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ---- Maps ----------------------------------------------------------------
# Optional: a map tile/JS key. Without it the app shows a labelled demo map.
NEXT_PUBLIC_MAPS_API_KEY=

# ---- P1: notifications -----------------------------------------------------
# Every notification is stored in-app. Set to true to also send Expo push to registered device tokens.
EXPO_PUSH_ENABLED=false
# Optional SMS (off by default). POSTs { to, text } as JSON to SMS_WEBHOOK_URL; without a URL it only logs.
SMS_ENABLED=false
SMS_WEBHOOK_URL=
# Where private uploads (reports, onboarding documents, logos) are stored in demo mode
UPLOAD_DIR=./data/uploads

# ---- P2: delivery hand-off for donations --------------------------------------
# mock (default, simulates a rider on a timer) | dunzo | porter. The real partners are stubs until their APIs are integrated.
DELIVERY_PROVIDER=mock
DUNZO_API_KEY=
PORTER_API_KEY=
# Partner status webhooks (POST /api/delivery/webhook) must carry x-delivery-signature = hex HMAC-SHA256 of the raw body with this secret.
DELIVERY_WEBHOOK_SECRET=
