# ---- Mode -------------------------------------------------------------
# "demo" runs everything against a local JSON store with simulated payments.
# "supabase" switches the data adapter to Supabase (see supabase/migrations).
DATA_MODE=demo
# Path of the demo store (created and seeded on first run)
DEMO_DB_PATH=./data/demo-db.json
# Secret used to sign the demo session cookie. Change it.
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Supabase (server-only service key; never expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Razorpay TEST MODE only -------------------------------------------
# Leave blank to use the clearly labelled demo payment adapter.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ---- Maps ----------------------------------------------------------------
# Optional: a map tile/JS key. Without it the app shows a labelled demo map.
NEXT_PUBLIC_MAPS_API_KEY=
